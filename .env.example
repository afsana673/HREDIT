PORT=3000
NODE_ENV=development
API_KEY=replace-this-with-a-long-random-secret
# Keep your OWN authorized ImgUpscaler account credentials private.
IMGUPSCALER_COOKIE=
IMGUPSCALER_AUTHORIZATION=
IMGUPSCALER_ORIGIN=
IMGUPSCALER_REFERER=
# Example for any required non-standard upstream headers:
# UPSTREAM_HEADERS_JSON={"x-custom-auth":"your-value"}
CORS_ORIGIN=
UPSTREAM_TIMEOUT_MS=60000
MAX_BODY_BYTES=5242880
# Signed-upload CORS fallback security: allow only your authorized object storage domains.
MAX_UPLOAD_BYTES=25165824
UPLOAD_ALLOWED_HOST_SUFFIXES=aliyuncs.com,amazonaws.com,cloudflarestorage.com,imgupscaler.ai,googleapis.com,myqcloud.com
